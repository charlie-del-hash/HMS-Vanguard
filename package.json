{
  "name": "affinity-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Affinity research funnel \u2014 the Astro site, the ops deck it grew out of, and the checks that hold both",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/vercel-config.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "node --experimental-strip-types scripts/seed-db.mjs",
    "seed:sql": "node --experimental-strip-types scripts/seed-db.mjs --sql",
    "test": "node checks/run.js",
    "check": "npm test",
    "typecheck": "astro check",
    "check:site": "npm run build && node checks/run-site.js",
    "check:db": "node checks/db-rls.js",
    "check:all": "npm test && npm run check:site && npm run check:db"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/vercel": "11.0.10",
    "@chenglou/pretext": "0.0.9",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/routing-utils": "6.5.0",
    "astro": "7.3.2",
    "motion": "13.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  }
}
