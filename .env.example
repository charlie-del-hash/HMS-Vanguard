# Copy to .env for local work. .env is gitignored.
#
# The same two PUBLIC_ values have to be set in the Vercel project as well:
# report pages are prerendered, so the BUILD reads content, not just the runtime.

# Project: affinity-research (Dorsal org, eu-west-2 London)
PUBLIC_SUPABASE_URL=https://zwoaopkxjyydjlakrqwx.supabase.co

# Publishable key. Public by design — it ships inside the page, and what
# protects the data is RLS rather than this string. Through it a caller can read
# published reports and the data behind them and nothing else; the funnel tables
# have RLS with no policy, so they are unreachable with it.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HnHSRM9eROGQJpCVE3jesQ_XP2kQqtp

# Service role. BYPASSES RLS COMPLETELY. Server only — never in a client script,
# never in a PUBLIC_ variable, never committed. Take it from
# Supabase → Project Settings → API Keys → service_role.
# Not needed until Phase 3 (the admin) and Phase 4 (the analytics endpoint).
SUPABASE_SERVICE_ROLE_KEY=
