---
import Base from "../../layouts/Base.astro";
import ChartFrame from "../../components/ChartFrame.astro";
import { MARK_SHAPES } from "../../lib/charts/marks";
import type { ChartSpec } from "../../lib/charts/render";

/* Indicative data, shaped like the feed that replaces it. Everything on this
   page says so — the deck's rule that placeholder figures declare themselves
   where the figures are, not in a footnote underneath them. */

const WK = ["W27", "W28", "W29", "W30", "W31", "W32", "W33", "W34"];

const transits = [412, 398, 421, 366, 289, 254, 271, 302].map((v, i) => ({
  wk: WK[i],
  n: v,
}));

const segments = [
  { name: "VLCC", ret: 34.2, n: 6, k: "vlcc" },
  { name: "Suezmax", ret: 28.7, n: 5, k: "suez" },
  { name: "Aframax", ret: 22.1, n: 4, k: "afra" },
  { name: "Product carriers", ret: 17.4, n: 5, k: "prod" },
  { name: "LNG", ret: 11.9, n: 3, k: "lng" },
  { name: "Dry bulk", ret: 4.2, n: 4, k: "dry" },
];

/* A basket and one constituent on the same rebase — the case that forced the
   collision-avoidance placement in the first place. */
const basket = [100, 101.4, 103.8, 108.2, 119.6, 128.4, 124.1, 126.9];
const single = [100, 99.2, 104.6, 112.8, 131.4, 146.2, 138.7, 142.3];
const idxRows = WK.map((wk, i) => ({ wk, v: basket[i]! }));
const ovRows = WK.map((wk, i) => ({ wk, v: single[i]! }));

const NAMES = [
  ["FRO", "Frontline", 1.42, 8.9, 2], ["DHT", "DHT Holdings", 1.18, 7.4, 2],
  ["INSW", "Intl Seaways", 1.05, 9.8, 2], ["TNK", "Teekay Tankers", 0.94, 6.1, 2],
  ["STNG", "Scorpio Tankers", 1.31, 5.2, 2], ["TRMD", "TORM", 1.22, 11.4, 2],
  ["HAFN", "Hafnia", 1.09, 12.8, 2], ["OET", "Okeanis Eco", 1.55, 13.9, 2],
  ["NAT", "Nordic American", 0.88, 9.1, 2], ["ECO", "Performance Ship", 0.61, 0.0, 2],
  ["SBLK", "Star Bulk", 0.97, 7.2, 1], ["GNK", "Genco", 0.83, 6.4, 1],
  ["GOGL", "Golden Ocean", 1.12, 8.1, 1], ["SB", "Safe Bulkers", 0.72, 4.9, 1],
  ["DAC", "Danaos", 0.54, 4.1, 0], ["CMRE", "Costamare", 0.68, 3.2, 0],
  ["ZIM", "ZIM Integrated", 1.94, 21.3, 0], ["MATX", "Matson", 2.31, 1.1, 0],
  ["GLNG", "Golar LNG", 1.48, 2.4, 4], ["FLNG", "Flex LNG", 1.63, 9.6, 4],
  ["ICT", "Intl Container", 2.84, 2.1, 3], ["DPW", "DP World", 1.21, 3.4, 3],
  ["HHFA", "Hamburger Hafen", 0.79, 5.1, 3],
] as const;

const scatterPts = NAMES.map(([tk, co, pnav, yld, group]) => ({
  id: tk,
  title: `${tk} · ${co} — ${pnav.toFixed(2)}× NAV, ${yld.toFixed(1)}% yield (indicative)`,
  x: pnav,
  y: yld,
  group,
  shape: MARK_SHAPES[group]!,
}));

const priceHist = [38, 41, 39, 44, 52, 58, 61, 57, 63, 71, 68, 74].map((p, i) => ({
  p,
  t: `D${i + 1}`,
}));

const specs: { title: string; note: string; spec: ChartSpec; ssrWidth?: number }[] = [
  {
    title: "Area · transits per week",
    note: "Dashed mean reference. Value labels thin out below 40px of point spacing rather than shrinking.",
    spec: { kind: "area", rows: transits, xk: "wk", yk: "n", label: "Hormuz transits per week" },
  },
  {
    title: "Bar · segment return",
    note: "Hue follows the entity, never its rank, so re-sorting never repaints the survivors. A two-word name wraps before the type comes down, and floors at 8.5px.",
    spec: {
      kind: "bar", rows: segments, xk: "name", yk: "ret",
      label: "Return by segment", countKey: "n",
    },
  },
  {
    title: "Index · basket with one name overlaid",
    note: "The case that forced the placement pass: every figure takes the first free position from a set holding both series' stroked geometry, the rebase rule, every mark, the x labels and the figures already placed.",
    spec: {
      kind: "index", rows: idxRows, xk: "wk", yk: "v", base: 100,
      label: "War-risk basket rebased to 100",
      overlay: { rows: ovRows, name: "OET", color: "#2F6FD0" },
    },
  },
  {
    title: "Index · side geometry, no overlay",
    note: "Same chart, narrower margins. Both take their width from the slot, so the type is the same size on screen either way.",
    spec: { kind: "index", rows: ovRows, xk: "wk", yk: "v", base: 100, side: true, label: "OET rebased" },
    ssrWidth: 336,
  },
  {
    title: "Scatter · relative value",
    note: "P/NAV on a log axis, because it is a ratio: 0.5× and 2× are the same distance from parity. Category is carried by shape as well as hue — the two accepted contrast warnings are legal only while colour is never alone.",
    spec: {
      kind: "scatter", points: scatterPts, parity: 1, parityLabel: "NAV",
      xLabel: "PRICE / NAV", yLabel: "DIVIDEND YIELD %",
      quadrants: ["CHEAP · PAYING", "EXPENSIVE · THIN"],
      quadrantsTerse: ["CHEAP", "EXPENSIVE"],
    },
  },
  {
    title: "Price · binary market",
    note: "Dashed 50c parity with tinted regions either side. Marks drop to the last point above 13 ticks.",
    spec: { kind: "price", hist: priceHist, state: "open" },
  },
];
---

<Base
  title="Chart layer · Affinity"
  description="Every chart kind, drawn at true size, server-rendered and corrected on mount."
  noindex
>
  <main class="article">
    <header>
      <p class="label">Affinity · design system</p>
      <h1 class="display">Chart layer</h1>
      <p class="dek">
        Six generators, ported from the ops deck. Each is a pure function of
        (data, width, palette) returning SVG, so the same code runs on the server
        and in the browser. Every figure here is <b>indicative</b> — shaped like the
        feed that replaces it, and not a live one.
      </p>
      <p class="engine">
        Rendered width: <b id="rw">…</b> · scale <b id="sc">…</b> · type <b id="ts">…</b>
      </p>
    </header>

    {
      specs.map((s) => (
        <section class="wide">
          <h2 class="label gh">{s.title}</h2>
          <p class="note">{s.note}</p>
          <div class="panel cqpanel">
            <ChartFrame spec={s.spec} ssrWidth={s.ssrWidth} source="Indicative — not a live feed" />
          </div>
        </section>
      ))
    }
  </main>

  <script is:inline>
    /* The guarantee, read back off the live DOM: viewBox width must equal CSS
       width (scale 1.000) and no rendered label may fall outside 8.5–13px. */
    function audit() {
      const svgs = document.querySelectorAll("svg.chart");
      let minS = Infinity, maxS = 0, minT = Infinity, maxT = 0, w = 0;
      for (const s of svgs) {
        const r = s.getBoundingClientRect();
        if (!r.width || !s.viewBox.baseVal.width) continue;
        const scale = r.width / s.viewBox.baseVal.width;
        minS = Math.min(minS, scale); maxS = Math.max(maxS, scale);
        w = Math.max(w, Math.round(r.width));
        for (const t of s.querySelectorAll("text")) {
          if (t.closest(".ph")) continue;
          const fs = parseFloat(getComputedStyle(t).fontSize) * scale;
          if (!fs) continue;
          minT = Math.min(minT, fs); maxT = Math.max(maxT, fs);
        }
      }
      document.getElementById("rw").textContent = w + "px";
      document.getElementById("sc").textContent =
        minS === maxS ? minS.toFixed(3) : minS.toFixed(3) + "–" + maxS.toFixed(3);
      document.getElementById("ts").textContent = minT.toFixed(1) + "–" + maxT.toFixed(1) + "px";
    }
    addEventListener("load", () => setTimeout(audit, 150));
    addEventListener("resize", () => setTimeout(audit, 250));
  </script>
</Base>

<style>
  main { padding-block: 44px 96px; row-gap: 38px; }
  h1 { font-size: clamp(30px, 6vw, 44px); color: var(--ink); }
  :global([data-theme="dark"]) h1 { color: var(--light-tl); }
  header { display: grid; gap: 10px; }
  .dek { color: var(--small); max-width: 62ch; }
  .engine { font-size: 13px; color: var(--small); }
  .engine b { font-family: var(--mono); color: var(--teal); font-variant-numeric: tabular-nums; }
  section { display: grid; gap: 4px; }
  .gh { padding-bottom: 8px; border-bottom: 1px solid var(--rule); }
  .note { color: var(--small); font-size: 13.5px; max-width: 74ch; margin-bottom: 14px; }
  .panel { padding: 18px; }
  @media (max-width: 560px) { .panel { padding: 12px; } }
</style>
