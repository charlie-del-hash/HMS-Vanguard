---
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
  /** Blocks indexing on dev-only surfaces. */
  noindex?: boolean;
}
const { title, description = "", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* nofollow and noarchive as well as noindex. A dev sheet or a sign-in page
        that is merely un-indexed can still be crawled for links and cached by
        anything that keeps copies. */}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    {/* The deck's own shield, decoded out of its inline data URI into one
        served file rather than re-inlined on every page. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Theme before first paint. The key is the deck's own, so a reader who
        chose dark on the ops deck keeps it here and vice versa. Wrapped
        because a file:// origin refuses storage outright in some browsers. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("affinity-ops-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.dataset.theme = t;
            return;
          }
        } catch {}
        if (window.matchMedia?.("(prefers-color-scheme: dark)").matches) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>

    {/* Anything a page needs in the head of its own: an og: tag, structured
        data, a per-page meta. Named rather than positional so a page cannot
        accidentally put its body content here. */}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
