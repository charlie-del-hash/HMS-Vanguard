---
/* The figures a reader takes away if they read nothing else.
 *
 * Two rules, both inherited rather than invented:
 *
 *   every tile says where its number came from. parsePayload refuses a KPI
 *   with neither a sourceKey nor indicative:true, so this component can rely
 *   on one of the two being there.
 *
 *   the value uses PROPORTIONAL figures. tabular-nums gives every digit the
 *   width of a zero, which reads loose at display size — HANDOFF.md has the
 *   note. Deltas stay tabular, because they sit in a column and must align.
 */
import type { ResolvedKpi } from "../../lib/blocks";

interface Props {
  items: ResolvedKpi[];
}
const { items } = Astro.props;

/** A delta's direction, taken from the glyph the author wrote. */
function dir(d?: string): "up" | "down" | "flat" {
  if (!d) return "flat";
  if (/^[+↑]/.test(d.trim())) return "up";
  if (/^[−\-↓]/.test(d.trim())) return "down";
  return "flat";
}
---

<div class="kpis cqpanel">
  {
    items.map((it) => (
      <div class="tile">
        <span class="label">{it.label}</span>
        <span class="row">
          <span class="display value">{it.value}</span>
          {it.unit && <span class="unit">{it.unit}</span>}
        </span>
        {it.delta && (
          <span class:list={["mono delta", dir(it.delta)]}>{it.delta}</span>
        )}
        <span class="foot">
          {it.source?.isIndicative || it.indicative ? (
            <span class="ind">Indicative</span>
          ) : null}
          {it.note && <span class="note">{it.note}</span>}
        </span>
      </div>
    ))
  }
</div>

<style>
  /* auto-fit rather than a column count: the row is used in the content lane
     and the wide lane, and a container query would still need a breakpoint per
     lane. This needs none — tiles wrap when they stop fitting. */
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    border-radius: var(--r);
    overflow: clip;
  }
  .tile {
    display: grid;
    gap: 3px;
    align-content: start;
    padding: 14px 15px 12px;
    background: var(--surface);
    min-width: 0;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 5px;
    min-width: 0;
  }
  .value {
    font-size: clamp(23px, 1.3rem + 0.6vw, 29px);
    color: var(--ink);
    /* A long figure must shrink the tile's own scroll, never the page's. */
    overflow-wrap: anywhere;
  }
  .unit {
    font-size: 11px;
    color: var(--small);
    white-space: nowrap;
  }
  .delta {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .delta.up {
    color: var(--pos);
  }
  .delta.down {
    color: var(--neg);
  }
  .delta.flat {
    color: var(--small);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-items: baseline;
    margin-top: 2px;
  }
  .ind {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-dk);
  }
  .note {
    font-size: 11px;
    color: var(--small);
  }
</style>
