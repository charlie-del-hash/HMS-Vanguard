---
/* A pulled quotation.
 *
 * `role` is where an unattributed or illustrative quote admits it. A quotation
 * with a confident-looking attribution that nobody actually said is the same
 * failure as a filing link beside an invented figure — it lends words an
 * authority they have not got.
 */
import type { QuotePayload } from "../../lib/blocks";

interface Props {
  payload: QuotePayload;
}
const { payload } = Astro.props;
const { text, who, role } = payload;
---

<figure class="quote">
  <blockquote>
    <p>{text}</p>
  </blockquote>
  {
    (who || role) && (
      <figcaption>
        {who && <span class="who">{who}</span>}
        {role && <span class="role">{role}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .quote {
    margin: 0;
    display: grid;
    gap: 9px;
    padding-left: 18px;
    border-left: 2px solid var(--teal);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
    font-size: clamp(17px, 1rem + 0.4vw, 20px);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 10px;
    align-items: baseline;
  }
  .who {
    font-size: 13px;
    color: var(--body);
  }
  .role {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--small);
  }
</style>
